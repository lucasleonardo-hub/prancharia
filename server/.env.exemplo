# Copie para .env e preencha. O .env nunca vai para o repositório.
GEMINI_API_KEY=

# Opcionais
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_MS=90000
PORT=3000
# Origens autorizadas do navegador, separadas por vírgula. * libera todas.
CORS_ORIGIN=*
# SIMULAR=1 responde sem chamar o Gemini, para testar a ligação do frontend.
SIMULAR=

# Cadeia de fallback: quando o Gemini estoura cota/erro, tenta Groq, depois
# OpenAI, nessa ordem. Deixe em branco para pular um provedor da cadeia.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
