# Copie para .env e preencha. O .env nunca vai para o repositório.
GEMINI_API_KEY=

# Opcionais
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_MS=90000
PORT=3000
# Origens autorizadas do navegador, separadas por vírgula. * libera todas.
CORS_ORIGIN=*
# SIMULAR=1 responde sem chamar o Gemini, para testar a ligação do frontend.
SIMULAR=

# Cadeia de fallback: quando o Gemini estoura cota/erro, tenta Groq, depois
# Cohere, depois Hugging Face, nessa ordem. Deixe em branco para pular um
# provedor da cadeia.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
COHERE_API_KEY=
COHERE_MODEL=c4ai-aya-vision-32b
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# OCR de memorial escaneado (iLoveAPI). Só a chave pública é usada hoje.
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# ---------------------------------------------------------------------
# BANCO PERSISTENTE (obrigatório no Render free / qualquer host de disco
# efêmero). Sem isto o SQLite fica em server/dados e SOME a cada
# hibernação/deploy — é o que fazia os empreendimentos "sumirem em outro
# navegador". Crie um banco gratuito em https://turso.tech, rode
#   turso db show --url <nome>      e   turso db tokens create <nome>
# e cole aqui (ou no painel Environment do Render):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Onde ficam os bytes das pranchas: "disco" (server/dados/pranchas) ou
# "banco" (tabela blobs do próprio banco). Vazio = banco quando há Turso,
# disco caso contrário.
ARMAZENAMENTO=
