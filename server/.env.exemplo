# Copie para .env e preencha. O .env nunca vai para o repositório.
GEMINI_API_KEY=

# Opcionais
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_MS=90000
PORT=3000
# Origens autorizadas do navegador, separadas por vírgula. * libera todas.
CORS_ORIGIN=*
# SIMULAR=1 responde sem chamar o Gemini, para testar a ligação do frontend.
SIMULAR=
